(* Usage: WolframKernel -script verify-finite-coordinate-system.wls RUN FINITEFLOW_ROOT [PACKAGE_ROOT] *)
scriptPosition=FirstPosition[$CommandLine,"-script"];args=If[MissingQ[scriptPosition],Rest[$ScriptCommandLine],Drop[$CommandLine,First[scriptPosition]+1]];
If[Length[args]<2,Print["Expected RUN and FINITEFLOW_ROOT"];Quit[1]];
run=ExpandFileName[args[[1]]];lib=ExpandFileName[args[[2]]];package=If[Length[args]>=3,ExpandFileName[args[[3]]],DirectoryName[DirectoryName[$InputFileName]]];
Get[FileNameJoin[{package,"Kernel","ConformalIBP.wl"}]];
file=FileNameJoin[{run,"DifferentialEquations.wl"}];candidate=Get[file];If[!AssociationQ[candidate]||!TrueQ[candidate["Report"]["FullDEClosed"]],Quit[2]];
If[candidate["Report"]["ImplementationHash"]=!=ConformalIBP`Private`$implementationHash,Print["Implementation hash mismatch"];Quit[3]];
families=candidate["Families"];basis=candidate["Basis"];matrices=candidate["Matrices"];vars=First[Values[families]]["Variables"];n=Length[basis];pt=candidate["Report"]["Point"];
If[Keys[matrices]=!=vars||!AllTrue[Values[matrices],Dimensions[#]==={n,n}&],Quit[4]];
out=FileNameJoin[{run,"independent-verification"}];If[!DirectoryQ[out],CreateDirectory[out]];started=AbsoluteTime[];
If[!TrueQ[InitializeFiniteFlow[lib,FileNameJoin[{lib,"mathlink"}]]],Quit[5]];
sizes=Association@KeyValueMap[(Length[FamilyPropagators[#2]]->#1)&,families];loopOf[g_G]:=Lookup[sizes,Length[List@@g],0];
poleLimits=AllTrue[ConformalIBP`Private`support[basis],KeyExistsQ[families,loopOf[#]]&&ConformalIBP`Private`representativePoleLimitsQ[families[loopOf[#]],#]&];If[!poleLimits,Print["Finite representative propagator power limits exceeded"];Quit[11]];
canG[g_G]:=canG[g]=If[KeyExistsQ[families,loopOf[g]],CanonicalIntegral[families[loopOf[g]],g],$Failed];
canB[b_BoundaryIntegral]:=Module[{mapped},If[!KeyExistsQ[families,b[[1]]],Return[b]];mapped=canG[G@@b[[2]]];If[FailureQ[mapped]||mapped===$Failed,b,mapped]];
map[e_]:=ConformalIBP`Private`canonicalLinear[e/.g_G:>canG[g]/.b_BoundaryIntegral:>canB[b]];
atomDerivative[g_G,z_]:=atomDerivative[g,z]=First[DifferentiateIntegrals[families[loopOf[g]],{g}]["Rows"][z]];
derivative[e_,z_]:=map[D[e,z]+Total[(Coefficient[Expand[e],#] atomDerivative[#,z])& /@ ConformalIBP`Private`support[e]]];
physicalInput=map /@ basis;physicalTop=map /@ candidate["OriginalInputs"];
physicalDE=Flatten[Table[derivative[#,z]& /@ basis,{z,vars}],1];
If[!FreeQ[{physicalInput,physicalTop,physicalDE},_Failure|$Failed]||!FreeQ[{physicalInput,physicalTop},_BoundaryIntegral],Print["Fresh native mapping failed"];Quit[6]];
finitePart[e_]:=AllTrue[GatherBy[ConformalIBP`Private`support[e],loopOf],Function[gs,With[{part=Total[(Coefficient[Expand[e],#] #)& /@ gs]},TrueQ[FiniteIntegralQ[families[loopOf[First[gs]]],part]]]]];
finite=AllTrue[physicalInput,finitePart];
manifest=ConformalIBP`Private`readCoordinateManifest[candidate["SourceManifest"]];
If[manifest["PhysicalPoolSHA256"]=!=FileHash[manifest["PhysicalPool"],"SHA256"],Quit[7]];
Get[manifest["PhysicalPool"]];pool=ConformalIBP`Private`fullCoordinatePool;rows=pool["Rows"];columns=pool["Columns"];
If[Hash[rows,"SHA256"]=!=candidate["Report"]["FullPoolHash"],Quit[8]];
queries=Join[ConformalIBP`Private`support[{physicalInput,physicalTop,physicalDE}],ConformalIBP`Private`sources[{physicalInput,physicalTop,physicalDE}]];witness=Unique["fullVerificationWitness"];cols=Join[{witness},columns,Complement[queries,columns]];
FiniteFlow`FFNewGraph[graph];FiniteFlow`FFGraphInputVars[graph,in,vars];
Print[<|"Event"->"IndependentFullMixedPoolLearning","Rows"->Length[rows],"Queries"->Length[queries],"Basis"->n|>];
FiniteFlow`FFAlgSparseSolver[graph,sys,{in},vars,#==0& /@ Prepend[rows,witness-First[queries]],cols,"NeededVars"->Append[queries,witness]];
FiniteFlow`FFSolverSparseOutput[graph,sys];FiniteFlow`FFGraphOutput[graph,sys];learn=FiniteFlow`FFSparseSolverLearn[graph,cols];
values=FiniteFlow`FFGraphEvaluateMany[graph,{pt},"NThreads"->1];If[!ListQ[learn]||!MatchQ[values,{_List}],Quit[9]];FiniteFlow`FFDeleteGraph[graph];
rules=FiniteFlow`FFSparseSolverSol[First[values],learn];prime=FiniteFlow`FFPrimeNo[0];point=Thread[vars->pt];
image[rr_]:=(rr/.point)/.Dispatch[rules];mod[q_]:=With[{v=Together[q]},If[MatchQ[v,_Integer|_Rational]&&Mod[Denominator[v],prime]=!=0,Mod[Numerator[v]PowerMod[Denominator[v],-1,prime],prime],$Failed]];
bi=image[physicalInput];di=image[physicalDE];ti=image[physicalTop];m=Map[mod,ConformalIBP`Private`coeff[bi,Join[ConformalIBP`Private`support[bi],ConformalIBP`Private`sources[bi]]],{2}];
independent=MatrixQ[m,IntegerQ]&&Length[Select[RowReduce[m,Modulus->prime],AnyTrue[#,UnequalTo[0]]&]]===n;
agreement=AllTrue[di-Flatten[Table[(matrices[v]/.point).bi,{v,vars}],1],ConformalIBP`Private`numericalLinearZeroQ[#,prime]&];
topPassed=AllTrue[ti-(candidate["OriginalTopCoordinates"]/.point).bi,ConformalIBP`Private`numericalLinearZeroQ[#,prime]&];
curvature=Table[With[{a=vars[[i]],b=vars[[j]]},Mod[Map[mod,(D[matrices[a],b]-D[matrices[b],a])/.point,{2}]+
 Map[mod,matrices[a]/.point,{2}].Map[mod,matrices[b]/.point,{2}]-Map[mod,matrices[b]/.point,{2}].Map[mod,matrices[a]/.point,{2}],prime]],{i,Length[vars]},{j,i+1,Length[vars]}];
flat=AllTrue[Flatten[curvature],SameQ[#,0]&];passed=TrueQ[finite&&independent&&agreement&&topPassed&&flat];
report=<|"Passed"->passed,"FullDEClosed"->passed,"BasisCount"->n,"NativeFiniteness"->finite,"Independent"->independent,"FreshNativeDEFullPoolAgreement"->agreement,"OriginalTopCoordinateAgreement"->topPassed,"FullCurvatureAtPointZero"->flat,"NoSourcesDiscarded"->True,"UnmappedPoolSourceCount"->Length[ConformalIBP`Private`sources[rows]],"BoundarySourceTreatment"->"RetainAll","SymbolicResidualCheckPerformed"->False,"Point"->pt,"Prime"->prime,"FullPoolHash"->pool["PoolHash"],"ImplementationHash"->ConformalIBP`Private`$implementationHash,"CandidateSHA256"->FileHash[file,"SHA256"],"Seconds"->N[AbsoluteTime[]-started]|>;
Export[FileNameJoin[{out,"Report.json"}],report,"RawJSON"];Put[<|"Report"->report,"Curvature"->curvature|>,FileNameJoin[{out,"Verification.wl"}]];Print[report];Quit[If[passed,0,10]];
