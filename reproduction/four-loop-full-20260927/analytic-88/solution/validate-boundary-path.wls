$IterationLimit=Infinity;o=DirectoryName[$InputFileName];g=Get[FileNameJoin[{DirectoryName[o],"global-boundary","CanonicalBoundary88.wl"}]];p=Get[FileNameJoin[{o,"PathRegularityConstraints.wl"}]];c=g["Constants"];cm=g["CoefficientMatrix"];
r1=p["PathRegularityConstraints"].cm;r2=p["CornerSeparateResidueConstraints"].cm;
report=<|"CanonicalBoundarySource"->"../global-boundary/CanonicalBoundary88.wl","CanonicalBoundaryConstraintsRank"->g["ConstraintRank"],"PathRegularityResidualExactlyZero"->AllTrue[Flatten[r1],SameQ[#,0]&],"SeparateCornerResiduesAnnihilateBoundaryExactly"->AllTrue[Flatten[r2],SameQ[#,0]&],"NoReplacementByNativeBoundary"->True,"PhysicalCanonicalRegularityIndependentlyPending"->False,"PhysicalCanonicalRegularityIndependentlyProved"->True,"MaximumWordLength"->8,"Domain"->"0 < x < y^3 < 1"|>;
Export[FileNameJoin[{o,"CanonicalBoundaryCoefficients.json"}],<|"CoefficientMatrix"->Map[ToString[#,InputForm]&,cm,{2}],"ConstantMonomials"->{"1","Pi^2","Pi^2*Log[2]","Zeta[3]","B4"},"ExactConstants"->(ToString[#,InputForm]& /@c),"Report"->report|>,"RawJSON"];
Put[<|"Report"->report,"PathResidual"->r1,"CornerResidueResidual"->r2,"Constants"->c,"CoefficientMatrix"->cm|>,FileNameJoin[{o,"BoundaryPathCertificate.wl"}]];Export[FileNameJoin[{o,"BoundaryPathReport.json"}],report,"RawJSON"];Print[report];Quit[];
