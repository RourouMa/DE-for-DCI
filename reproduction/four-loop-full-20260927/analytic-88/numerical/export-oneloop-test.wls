$IterationLimit=Infinity;out=DirectoryName[$InputFileName];root=DirectoryName[DirectoryName[out]];a=Get[FileNameJoin[{root,"four-loop-dlog-20260927","structure","Full88DLogCandidate.wl"}]];t=a["NativeToNew"];ids=Select[Range[88],DeleteDuplicates[Flatten[Position[t[[#]],Except[0],{1},Heads->False]]] =!={} && Complement[Flatten[Position[t[[#]],Except[0],{1},Heads->False]],Range[80,83]]==={}&];f={1/(2x y),Log[y]/(x(y^2-1)),Log[x]/(y(x^2-1)),2Log[x]Log[y]/((x^2-1)(y^2-1))};g=Map[Factor,t[[ids,80;;83]].f];b=Limit[Limit[g,y->1],x->1];
Print["ids ",ids," functions ",g," boundary ",b];Put[<|"Indices"->ids,"Functions"->g,"Boundary"->b,"T"->t[[ids,80;;83]]|>,FileNameJoin[{out,"OneLoopValidation.wl"}]];
Export[FileNameJoin[{out,"OneLoopValidation.json"}],<|"Indices"->(ids-1),"Functions"->(ToString[#,InputForm]& /@ g),"Boundary"->(ToString[#,InputForm]& /@ b)|>,"RawJSON"];Quit[0];
