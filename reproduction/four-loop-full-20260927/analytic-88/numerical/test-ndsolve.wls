$IterationLimit=Infinity;out=DirectoryName[$InputFileName];root=DirectoryName[DirectoryName[out]];a=Get[FileNameJoin[{root,"four-loop-dlog-20260927","structure","Full88DLogCandidate.wl"}]];o=Get[FileNameJoin[{out,"OneLoopValidation.wl"}]];ids=o["Indices"];xx=4/5-11t/20;yy=19/20-t/5;cs=SparseArray[#[[ids,ids]]]& /@a["ResidueMatrices"];ww=a["Letters"]/.{x->xx,y->yy};conn=Sum[cs[[k]]Cancel[D[ww[[k]],t]/ww[[k]]],{k,Length[ww]}];ini=N[o["Functions"]/.{x->4/5,y->19/20},80];uv=Table[Unique["u"],{4}];eqs=Join[Thread[(Derivative[1][#][t]& /@uv)==conn.(#[t]& /@uv)],Thread[(#[0]& /@uv)==ini]];sol=NDSolveValue[eqs,uv,{t,0,1},WorkingPrecision->80,AccuracyGoal->50,PrecisionGoal->50,MaxSteps->Infinity,Method->"Extrapolation"];v=(#[1]& /@sol);exact=N[o["Functions"]/.{x->1/4,y->3/4},80];err=Max[Abs[v-exact]];Print["error ",InputForm[err]];Export[FileNameJoin[{out,"OneLoopNDSolveValidation.json"}],<|"MaxError"->ToString[err,InputForm],"Passed"->TrueQ[err<10^-45],"WorkingPrecision"->80,"AccuracyGoal"->50,"PrecisionGoal"->50|>,"RawJSON"];Quit[0];
