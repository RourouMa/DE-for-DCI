$IterationLimit=Infinity;o=DirectoryName[$InputFileName];root=DirectoryName[o];argpos=FirstPosition[$CommandLine,"-script"];runargs=Drop[$CommandLine,First[argpos]+1];slope=If[runargs==={},4,ToExpression[First[runargs]]];out=FileNameJoin[{o,If[slope===4,"global-boundary","global-boundary-ray"<>ToString[slope]]}];If[!DirectoryQ[out],CreateDirectory[out]];
c=Get[FileNameJoin[{root,"dlog","Full88DLog.wl"}]];n=88;ray={x->1-slope s,y->1-s};
zero[e_]:=SameQ[Cancel[Together[e]],0];
ti=Map[Cancel[Together[#/.ray]]&,c["NewToNative"],{2}];
val[e_]:=If[e===0,Infinity,Exponent[Numerator[e],s,Min]-Exponent[Denominator[e],s,Min]];
vals=Map[val,ti,{2}];kmax=Max[0,-Min[Flatten[vals]]];Print["Inverse maximum pole order ",kmax];
Put[<|"InverseOnRay"->ti,"Valuations"->vals,"MaximumPoleOrder"->kmax|>,FileNameJoin[{out,"InverseOnRay.wl"}]];
li=c["Letters"]/.ray;kernel=Cancel[D[#,s]/#]&/@li;
bs=Table[Sum[c["ResidueMatrices"][[a]]SeriesCoefficient[kernel[[a]],{s,0,k}],{a,Length[li]}],{k,-1,kmax-1}];
r=First[bs];rp=NestList[r.#&,IdentityMatrix[n],9];nilpotent=AllTrue[Flatten[r.Last[rp]],SameQ[#,0]&];
If[!nilpotent,Print["Residue not nilpotent"];Quit[2]];
Print["Rational coefficients ",AllTrue[Flatten[bs],MatchQ[#,_Rational|_Integer]&]," nilpotent ",nilpotent];
ps={IdentityMatrix[n]};Do[inv=Total[Table[rp[[j+1]]/k^(j+1),{j,0,9}]];AppendTo[ps,inv.Total[Table[bs[[j+2]].ps[[k-j]],{j,0,k-1}]]];Print["Taylor matrix ",k," rational ",AllTrue[Flatten[Last[ps]],MatchQ[#,_Rational|_Integer]&]],{k,1,kmax}];
Put[<|"Ray"->ray,"Residue"->r,"ConnectionCoefficients"->bs,"TaylorMatrices"->ps,"MaximumOrder"->kmax|>,FileNameJoin[{out,"CanonicalTaylorMatrices.wl"}]];
entries=Position[ti,z_/;z=!=0,{2},Heads->False];series=ConstantArray[0,{kmax+1,n,n}];
Do[{i,j}=ij;ss=Normal[Series[ti[[i,j]],{s,0,0}]];Do[series[[k+kmax+1,i,j]]=Coefficient[ss,s,k],{k,-kmax,0}],{ij,entries}];Print["Inverse Laurent coefficients ready"];
original=Table[Sum[series[[k-j+kmax+1]].ps[[j+1]],{j,0,k+kmax}],{k,-kmax,0}];
bb=Get[FileNameJoin[{o,"boundary","BoundaryValues88.wl"}]]["Values"];
bb=Join[ConstantArray[bc4,53],Take[bb,-35]]/.{Log[4]->2Log[2],Log[16]->4Log[2]};
bb=Expand[bb/.{Pi->pp,Log[2]->ll,Zeta[3]->zz}];mons={1,pp^2,pp^2 ll,zz,bc4};
bv=Table[{bb[[i]]/.{pp->0,ll->0,zz->0,bc4->0},Coefficient[Coefficient[bb[[i]],pp,2],ll,0],Coefficient[Coefficient[bb[[i]],pp,2],ll,1],Coefficient[bb[[i]],zz],Coefficient[bb[[i]],bc4]},{i,n}];
If[!AllTrue[Flatten[bv],MatchQ[#,_Rational|_Integer]&]||!AllTrue[Expand[bv.mons-bb],SameQ[#,0]&],Print["Boundary coefficient decomposition failed"];Quit[3]];
q=Join[r,Sequence@@original];rhs=Join[ConstantArray[0,{n(kmax+1),Length[mons]}],bv];
prime=1000000007;mod=Map[Mod[Numerator[#]PowerMod[Denominator[#],-1,prime],prime]&,q,{2}];red=RowReduce[Transpose[mod],Modulus->prime];pivots=Flatten[Table[If[AllTrue[row,SameQ[#,0]&],{},First[FirstPosition[row,a_/;a!=0]]],{row,red}]];
rank=Length[pivots];Print["Boundary constraints rank ",rank,"/",n," rows ",Length[q]];
If[rank===n,sol=LinearSolve[q[[pivots]],rhs[[pivots]]];res=q.sol-rhs;passed=AllTrue[Flatten[res],SameQ[#,0]&];Print["Boundary full residual ",passed];const=sol.mons/.{pp->Pi,ll->Log[2],zz->Zeta[3],bc4->Get[FileNameJoin[{o,"boundary","B4ExactConstant.wl"}]]};
 Put[<|"Constants"->const,"CoefficientMatrix"->sol,"ConstantMonomials"->mons,"ConstraintRank"->rank,"ResidualExactlyZero"->passed,"Ray"->ray,"Residue"->r,"TaylorMatrices"->ps|>,FileNameJoin[{out,"CanonicalBoundary88.wl"}]];
 Export[FileNameJoin[{out,"Report.json"}],<|"Passed"->passed,"ConstraintRank"->rank,"UnknownConstants"->n,"UniqueWithinRegularCanonicalSolutions"->True,"MaximumInversePoleOrder"->kmax,"Ray"->{slope,1},"ResidueNilpotent"->nilpotent,"PhysicalCanonicalRegularityStillRequiresJustification"->True|>,"RawJSON"],
 Put[<|"ConstraintMatrix"->q,"RHS"->rhs,"Monomials"->mons,"Rank"->rank,"Residue"->r,"TaylorMatrices"->ps|>,FileNameJoin[{out,"UnderdeterminedBoundary.wl"}]];
 Export[FileNameJoin[{out,"Report.json"}],<|"Passed"->False,"ConstraintRank"->rank,"UnknownConstants"->n,"RemainingDirections"->(n-rank),"MaximumInversePoleOrder"->kmax|>,"RawJSON"]];Quit[];
