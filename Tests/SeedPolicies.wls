root=DirectoryName[DirectoryName[$InputFileName]];Get[FileNameJoin[{root,"Kernel","ConformalIBP.wl"}]];
assert[test_,name_]:=If[TrueQ[test],Print["PASS ",name],Print["FAIL ",name];Quit[1]];
Get[FileNameJoin[{root,"Examples","kinematics.wl"}]];
f=LadderFamily[3,kinematics,{x,y}];f=CreateFamily[Join[KeyDrop[f,{"Hash"}],<|"IntegralOrdering"->"LadderFirst"|>]];
gaps={G[0,-1,0,4,0,-1,2,2,0,2,0,2,1,0,0,1,1,1],G[0,0,0,3,-1,-1,3,2,0,2,0,2,1,0,0,1,1,1],G[0,0,0,3,0,-2,2,3,0,2,0,2,1,0,0,1,1,1]};
inside=ConformalIBP`Private`originalDomainIntegralQ;
seeds[plan_]:=Union[Flatten[Lookup[plan["Batches"],"Seeds"]]];
ops=GenerateOperators[f];
domain=GenerateSeeds[f,gaps,ops,"SeedCenters"->"AllOriginalImages"];
extended=GenerateSeeds[f,gaps,ops,"SeedDomain"->"Extended","SeedCenters"->"AllOriginalImages"];
single=GenerateSeeds[f,gaps,ops,"SeedCenters"->"AllOriginalImages","BlockExpansion"->"SingleBlock"];
assert[domain["SeedDomain"]==="Original" && And@@(inside[f,#]& /@ seeds[domain]),"default actual seeds stay in original TopSector"];
assert[Length[domain["Centers"]]>Length[gaps] && domain["UnmappedCenters"]==={},"all original block-symmetry images seed the three real gaps"];
assert[Complement[seeds[domain],seeds[extended]]==={} && AnyTrue[seeds[extended],!inside[f,#]&],"extended opt-in strictly enlarges actual seed domain"];
assert[Complement[seeds[single],seeds[domain]]==={} && Length[seeds[single]]<Length[seeds[domain]],"single-block expansion is a strict subset for factorized gaps"];
assert[And@@(inside[f,CanonicalIntegral[f,#]]& /@ gaps),"ladder-priority canonical representatives stay inside when available"];
connected=G@@Join[f["TopSector"],{1,1,1}];
p=GenerateSeeds[f,{connected},Take[ops,1],"SeedCenters"->"AllOriginalImages"];
assert[p["Centers"]=!={} && MemberQ[p["Centers"],connected],"symmetry seed centers also cover connected targets"];
assert[FailureQ[GenerateSeeds[f,gaps,ops,"SeedDomain"->"bad"]],"invalid seed policy rejected"];
assert[Lookup[Association[Options[RunDE]],"SeedDomain"]==="Original" && TrueQ[Lookup[Association[Options[RunDE]],"GapSeeding"]],"campaign defaults enable original-domain gap repair"];
assert[Lookup[Association[Options[RunDE]],"GenerationPolicy"]==="OnDemand","campaign generates on demand"];
a=G[1];b=G[2];c=BoundaryIntegral[1,{1}];rows={(x^2-1)/(x-1)a+y b,c-a,0};
assert[ConformalIBP`Private`coeff[rows,{a,b,c}]===Table[Together[Coefficient[Expand[r],g]],{r,rows},{g,{a,b,c}}],"coefficient extraction matches legacy matrix exactly"];
assert[$MessageList==={},"no unexpected Wolfram messages"];Quit[0];
