root=DirectoryName[DirectoryName[$InputFileName]];
Get[FileNameJoin[{root,"Kernel","ConformalIBP.wl"}]];
Get[FileNameJoin[{root,"Examples","kinematics.wl"}]];
assert[b_,s_]:=If[TrueQ[b],Print["PASS ",s],Print["FAIL ",s];Quit[1]];
f=LadderFamily[1,kinematics,{x,y}];g=G[1,1,1,1,1];op=First[GenerateOperators[f]];
p=CoupledIBPRelation[f,{<|"Coefficient"->1,"Seed"->g,"Operator"->op|>}];
assert[AssociationQ[p] && ConformalIBP`Private`zero[p["Equation"]-IBPRelation[f,op,g]],"complete action equals ordinary accepted IBP"];
assert[FailureQ[CoupledIBPRelation[f,{<|"Coefficient"->x,"Seed"->g,"Operator"->op|>}]],"kinematic action weights rejected"];
assert[FailureQ[CoupledIBPRelation[f,{<|"Coefficient"->1,"Seed"->g,"Operator"->Join[op,<|"Degree"->{1}|>]|>}]],"forged operator degree rejected"];
r=FindCoupledIBPRelations[f,{g}];assert[AssociationQ[r] && r["Equations"]=!={} && r["RejectedCandidates"]==={},"search and independent certification"];
f2=LadderFamily[2,kinematics,{x,y}];a=G[2,0,0,0,0,2,0,0,2,1,1];op2=First[Select[GenerateOperators[f2],#["Degree"]==={0,0}&]];
p=CoupledIBPRelation[f2,{<|"Coefficient"->1,"Seed"->a,"Operator"->op2|>}];
assert[FailureQ[p],"uncancelled single action rejected"];
p=CoupledIBPRelation[f2,{<|"Coefficient"->1,"Seed"->a,"Operator"->op2|>,<|"Coefficient"->-1,"Seed"->a,"Operator"->op2|>}];
assert[AssociationQ[p] && p["Equation"]===0,"complete cancellation evaluated before rejection"];
r=FindCoupledIBPRelations[f2,{a}];assert[AssociationQ[r] && r["RejectedCandidates"]==={},"contact kernel does not discard infinity terms"];
system=GenerateSystem[f,{g},"CoupledSeedGroups"->{{g}}];
assert[AssociationQ[system] && Length[system["CoupledSearches"]]===1,"system integrates coupled search"];
repeat=GenerateSystem[f,{g},"CoupledSeedGroups"->{{g}},"CompletedApplications"->system["Applications"],"CompletedCoupledGroups"->system["CompletedCoupledGroups"]];
assert[AssociationQ[repeat] && repeat["CoupledSearches"]==={},"separate coupled completion ledger"];
f4=LadderFamily[4,kinematics,{x,y}];
fixture=Get[FileNameJoin[{root,"Tests","Fixtures","CoupledFourLoop.wl"}]];
p=CoupledIBPRelation[f4,fixture["Terms"]];
assert[AssociationQ[p] && ConformalIBP`Private`zero[(p["UncanonicalizedEquation"]/._BoundaryIntegral->0)-fixture["ExpectedG4"]],"six-term four-loop identity matches independently published result"];
primitive=IBPRelation[f4,#["Operator"],#["Seed"]]& /@ fixture["Terms"];
assert[AnyTrue[primitive,FailureQ],"fixture recovers an identity lost by primitive admission"];
Needs["ProcessLink`"];
streams=CreateDirectory[FileNameJoin[{$TemporaryDirectory,"coupled-workers-"<>CreateUUID[]}]];
parallel=Block[{ProcessLink`Private`$TempPrefix=FileNameJoin[{streams,"wl-stream-std"}]},GenerateSystem[f,{g},"Workers"->4,"CoupledSeedGroups"->{{g}}]];
assert[AssociationQ[parallel] && parallel["Equations"]===system["Equations"] && Length[parallel["CoupledSearches"]]===1,"joint search runs once after ordinary workers merge"];
empty=FindCoupledIBPRelations[f,{}];
assert[AssociationQ[empty] && empty["Equations"]==={} && empty["RejectedCandidates"]==={},"empty search returns consistent audit schema"];
boxes=G@@Join[ConstantArray[1,16],ConstantArray[0,6],ConstantArray[1,4]];
assert[FailureQ[GenerateSystem[f4,{},"Operators"->{},"CoupledSeedGroups"->{{boxes}}]],"Original seed policy also guards joint groups"];
Print["ALL PASSED"];Quit[];
