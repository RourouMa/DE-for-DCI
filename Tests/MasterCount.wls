Get[FileNameJoin[{DirectoryName[DirectoryName[$InputFileName]],"Kernel","ConformalIBP.wl"}]];
assert[test_,name_]:=If[TrueQ[test],Print["PASS ",name],Print["FAIL ",name];Quit[1]];
a=CriticalPointCount[1+z^3,{z}];
assert[a["Count"]===2&&a["MultiplicityIncluded"],"degenerate proper critical point has Milnor multiplicity two"];
assert[CriticalPointCount[z^2,{z}]["Count"]===0,"saturation excludes critical points on P=0"];
assert[CriticalPointCount[1+z^3+w^4,{z,w}]["Count"]===6,"multivariate quotient counts multiplicity six"];
sym=CriticalPointCount[1+z^3+w^3,{z,w},"PermutationSymmetries"->{{2,1}}];
assert[sym["Count"]===4&&sym["CountAfterSymmetry"]===3&&Sort[sym["Symmetry"]["Traces"]]==={2,4},"symmetry trace handles multiplicities and fixed directions instead of dividing by group order"];
assert[FailureQ[CriticalPointCount[1+z^3+w^4,{z,w},"PermutationSymmetries"->{{2,1}}]],"non-kinematic symmetry is rejected"];
assert[FailureQ[CriticalPointCount[1+z^2,{z,w}]],"nonisolated locus is not silently counted as zero"];
assert[CriticalPointCount[1+z^3,{z},"Method"->"Euler"]["Count"]===3,"generic logarithmic count includes torus Euler contribution"];
assert[CriticalPointCount[1+z^2+w^2,{z,w},"Method"->"Euler"]["Count"]===4,"two-variable generic torus count"];
assert[CriticalPointCount[1+z^3,{z},"Modulus"->101]["Status"]==="FiniteFieldCount","modular count is not promoted to characteristic zero"];
assert[FailureQ[CriticalPointCount[1+z^3,{z},"MaxQuotientDimension"->1]],"resource limit returns no truncated count"];
assert[FailureQ[CriticalPointCount[1.+z^2,{z}]],"inexact input rejected"];
Get[FileNameJoin[{DirectoryName[DirectoryName[$InputFileName]],"Examples","kinematics.wl"}]];
f=LadderFamily[1,kinematics,{x,y}];p=ParametricRepresentation[f,{1,2,3,4}];v=p["Parameters"];
assert[Expand[p["U"]-Total[v]]===0&&Expand[p["F"]-v.f["Gram"].v]===0,"affine-chart one-loop Symanzik matches embedding Gram exactly"];
assert[CriticalPointCount[p["Polynomial"],v]["Count"]===1,"generic one-loop top sector has one proper critical point"];
all=MasterIntegralCount[f,{G[1,1,1,1,1]},"ProgressFunction"->None];
Print["ONE LOOP REFERENCE COUNT ",all["Count"]];
assert[all["OriginalSectorCount"]===16&&all["RepresentativeSectorCount"]===9,"all pinches partition into exact kinematic symmetry orbits"];
assert[all["UnquotientedReferenceCount"]===15&&all["Count"]===8,"one-loop reference count decreases from fifteen to eight by proven sector symmetries"];
assert[all["Status"]==="ReferenceEstimate"&&!all["IsMasterIntegralUpperBound"]&&MissingQ[all["CertifiedUpperBound"]],"ordinary generic count is not asserted to bound strict DCI"];
events={};blocked=RunDE[f,G[1,1,1,1,1],"MasterCountPreflight"->"Required","MasterCountStrategy"->"Geometry","ProgressFunction"->(AppendTo[events,#]&)];
assert[blocked["Status"]==="MasterCountUncertified"&&blocked["History"]==={}&&!blocked["Closed"],"required preflight returns an explicit unresolved status"];
assert[!AnyTrue[events,Lookup[#,"Event",None]==="RoundStarted"&],"required count occurs before the first DE round"];
assert[blocked["MasterCountPreflight"]["LoopCount"]===1&&MissingQ[blocked["MasterCountPreflight"]["LoopUpperBounds"][1]],"loop-specific unknown is not reported as zero or as the reference count"];
assert[FailureQ[RunDE[f,G[1,1,1,1,1],"MasterCountPreflight"->"Disabled","ProgressFunction"->None]],"disabled counting requires a recorded reason"];
assert[$MessageList==={},"no unexpected Wolfram messages"];
Quit[0];
