root=DirectoryName[DirectoryName[$InputFileName]];Get[FileNameJoin[{root,"Kernel","ConformalIBP.wl"}]];
assert[x_,label_]:=If[TrueQ[x],Print["PASS ",label],Print["FAIL ",label];Quit[1]];
Needs["ProcessLink`"];
streams=CreateDirectory[FileNameJoin[{$TemporaryDirectory,"target-test-"<>CreateUUID[]}]];
Block[{ProcessLink`Private`$TempPrefix=FileNameJoin[{streams,"wl-stream-std"}]},
 kin={SP[X1,X1]->2 x,SP[X3,X3]->2 x,SP[X2,X2]->2 y,SP[X4,X4]->2 y,SP[X1,X3]->1+x^2,SP[X2,X4]->1+y^2,SP[X1,X2]->0,SP[X1,X4]->0,SP[X2,X3]->0,SP[X3,X4]->0};
 f=LadderFamily[2,kin,{x,y}];g=CanonicalIntegral[f,G@@Join[f["TopSector"],{1,1}]];
 b1=BoundaryIntegral[1,{1,1,1,1,1}];b2=BoundaryIntegral[1,{2,0,2,0,1}];b3=BoundaryIntegral[1,{3,0,1,0,1}];b4=BoundaryIntegral[1,{4,0,0,0,1}];
 eq={g-b1,b1-2 b2,b3-3 b4};
 red=ReduceTargetIntegrals[f,{g,b1},eq,"Solver"->"Exact","MinimumSelectionRows"->0];
 assert[AssociationQ[red] && red["ReducedTargets"]==={2 b2,2 b2},"target reduction retains needed source constraint"];
 assert[Length[red["VerificationCertificate"]["OriginalRowIndices"]]===2,"disconnected irrelevant relation excluded"];
 assert[red["VerificationScope"]==="SelectedOriginalEquations" && !red["FullPoolEquationResidualsChecked"],"verification scope explicitly limited to certified subset"];
 rows=ConformalIBP`Private`canonExpr[f,#]& /@ eq;cert=red["VerificationCertificate"];
 assert[And@@(ConformalIBP`Private`zero /@ (rows[[cert["OriginalRowIndices"]]]/.Dispatch[cert["Rules"]])),"certificate independently verifies every selected original equation"];
 full=ReduceIntegrals[f,{g,b1},eq,"Solver"->"Exact"];
 assert[red["ReducedTargets"]===full["ReducedTargets"],"target images agree with independent full system"];
 assert[red["VerificationCertificate"]["NumericalSelectedRowSpaceChecked"],"modular rank and two-point residuals check selected row space"];
 overconstrained=ReduceTargetIntegrals[f,{g,b1},eq,"Solver"->Function[{rows,columns,queries},Thread[columns->ConstantArray[0,Length[columns]]]],"MinimumSelectionRows"->0];
 assert[FailureQ[overconstrained] && overconstrained[[1]]==="TargetRankCertificate","zero solution that imposes spurious constraints rejected despite zero residuals"];
 next=ReduceTargetIntegrals[f,{g,b3},eq,"Solver"->"Exact","MinimumSelectionRows"->0];
 assert[next["ReducedTargets"]==={2 b2,3 b4} && Length[next["VerificationCertificate"]["OriginalRowIndices"]]===3,"new query brings previously unneeded component into subset"];
 stronger=ReduceTargetIntegrals[f,{g},Append[eq,b2],"Solver"->"Exact","MinimumSelectionRows"->0];
 assert[stronger["ReducedTargets"]==={0},"new source constraint invalidates previous image"];
 historicalQueries=Union[{g},ConformalIBP`Private`support[red["Rules"]],ConformalIBP`Private`sources[red["Rules"]]];
 replay=ReduceTargetIntegrals[f,historicalQueries,Append[eq,b2-b4],"Solver"->"Exact","MinimumSelectionRows"->0];
 residual=ReplaceAll[(First /@ red["Rules"])-(Last /@ red["Rules"]),Dispatch[replay["Rules"]]];
 assert[And@@(ConformalIBP`Private`zero /@ residual),"historical source queries preserve old identities after system expansion"];
 free=ReduceTargetIntegrals[f,{g},{},"Solver"->"Exact","MinimumSelectionRows"->0];
 assert[free["ReducedTargets"]==={g} && free["UnseenTargets"]==={g},"empty system preserves unseen target"];
 assert[$MessageList==={},"no unexpected Wolfram messages"]];Quit[0];
