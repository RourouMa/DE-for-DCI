root=DirectoryName[DirectoryName[$InputFileName]];
Get[FileNameJoin[{root,"Kernel","ConformalIBP.wl"}]];
Get[FileNameJoin[{root,"Examples","kinematics.wl"}]];
assert[t_,label_]:=If[TrueQ[t],Print["PASS ",label],Print["FAIL ",label];Quit[1]];
assert[TrueQ[InitializeFiniteFlow[Environment["FINITEFLOW_ROOT"],FileNameJoin[{Environment["FINITEFLOW_ROOT"],"mathlink"}]]],"FiniteFlow initialization"];
Needs["ProcessLink`"];
dir=CreateDirectory[FileNameJoin[{$TemporaryDirectory,"dci-continuation-"<>CreateUUID[]}]];ProcessLink`Private`$TempPrefix=FileNameJoin[{dir,"wl-stream-std"}];
f=LadderFamily[1,kinematics,{x,y}];g=G[1,1,1,1,1];
options={"Solver"->"FiniteFlow","TargetSelector"->"FiniteFlowDirect","MasterCountStrategy"->"UserEstimate","MasterCountUserUpperBound"->4,"ProgressFunction"->None};
full=RunDE[f,g,Sequence@@options];
partial=RunDE[f,g,"MaxRounds"->2,Sequence@@options];
assert[AssociationQ[partial]&&partial["CurrentRound"]===2,"partial verified campaign available"];
events={};s=partial;s["Options"]=Join[s["Options"],<|"MaxRounds"->8,"DeferBoundaryCoefficientSimplification"->True,"ProgressFunction"->(AppendTo[events,#]&)|>];
bundle=<|"Epoch"->s["Epoch"],"EquationPoolHash"->Hash[s["Equations"],"SHA256"],"Round"->s["CurrentRound"],"Inputs"->s["CurrentInputs"],"History"->Select[s["History"],#["Round"]<s["CurrentRound"]&]|>;
s["VerifiedRoundContinuation"]=bundle;
continued=ConformalIBP`Private`runCampaign[s];
assert[continued["Closed"]&&continued["FlatnessVerified"]&&continued["Basis"]===full["Basis"]&&continued["Matrices"]===full["Matrices"],"continuation with deferred sources matches the full closed campaign"];
assert[First[Select[events,Lookup[#,"Event",None]==="RoundStarted"&]]["Round"]===2&&continued["OriginalInputs"]==={g},"continue the saved round while retaining original top"];
events={};extended=Join[s,<|"PendingRelations"->{0}|>];res=ConformalIBP`Private`runCampaign[extended];
assert[First[Select[events,Lookup[#,"Event",None]==="RoundStarted"&]]["Round"]===1&&res["Closed"],"pool expansion always restarts from original top"];
invalid=Join[s,<|"VerifiedRoundContinuation"->Append[bundle,"EquationPoolHash"->0]|>];
assert[FailureQ[ConformalIBP`Private`runCampaign[invalid]],"mismatched continuation certificate rejected"];
assert[$MessageList==={},"no unexpected messages"];Quit[0];
