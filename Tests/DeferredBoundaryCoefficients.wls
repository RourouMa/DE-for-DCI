root=DirectoryName[DirectoryName[$InputFileName]];
Get[FileNameJoin[{root,"Kernel","ConformalIBP.wl"}]];
Get[FileNameJoin[{root,"Examples","kinematics.wl"}]];
assert[t_,label_]:=If[TrueQ[t],Print["PASS ",label],Print["FAIL ",label];Quit[1]];
assert[TrueQ[InitializeFiniteFlow[Environment["FINITEFLOW_ROOT"],FileNameJoin[{Environment["FINITEFLOW_ROOT"],"mathlink"}]]],"FiniteFlow initialization"];
f=LadderFamily[2,kinematics,{x,y}];g=CanonicalIntegral[f,G@@Join[f["TopSector"],{1,1}]];b=BoundaryIntegral[1,{1,1,1,1,1}];
c=(x^8-y^8)/(x-y)-Sum[x^(7-k)y^k,{k,0,7}];rows={(x+1) g+c b,x g+(c+1) b};
normal=ConformalIBP`Private`canonicalLinear /@ rows;
deferred=Block[{ConformalIBP`Private`$deferBoundaryCoefficientSimplification=True},ConformalIBP`Private`closureLinear /@ rows];
assert[AllTrue[deferred-normal,ConformalIBP`Private`zero],"deferred rows retain the exact full expressions"];
assert[(deferred/._BoundaryIntegral->0)===(normal/._BoundaryIntegral->0),"highest-loop coefficients are identical"];
assert[!FreeQ[First[deferred],b]&&FreeQ[First[normal],b],"boundary cancellation is deferred rather than discarded"];
direct=BuildFiniteBasis[f,deferred];assert[direct["ExactCoverage"]&&AllTrue[deferred-direct["Weights"].direct["Basis"]-direct["BoundaryRows"],ConformalIBP`Private`zero],"direct finite cover retains complete source rows"];
span=Block[{ConformalIBP`Private`$deferBoundaryCoefficientSimplification=True},BuildSpanPreservingFiniteBasis[f,deferred,{g},<|"Rules"->{g->g}|>]];
assert[AssociationQ[span]&&span["ExactCoverage"]&&AllTrue[deferred-span["Weights"].span["ReducedBasis"]-span["BoundaryRows"],ConformalIBP`Private`zero],"adaptive finite cover retains complete source rows"];
bad=Block[{ConformalIBP`Private`$deferBoundaryCoefficientSimplification=True},ConformalIBP`Private`closureLinear[g b]];
assert[FailureQ[bad],"nonlinear integral products remain rejected"];
first=ConformalIBP`Private`campaignFiniteCover[f,rows,{g},<|"Rules"->{g->g}|>,"PreserveActualSpan"];
again=ConformalIBP`Private`campaignFiniteCover[f,rows,{g},<|"Rules"->{g->g}|>,"PreserveActualSpan"];
changed=ConformalIBP`Private`campaignFiniteCover[f,2 rows,{g},<|"Rules"->{g->g}|>,"PreserveActualSpan"];
assert[!first["FiniteCoverReused"]&&again["FiniteCoverReused"]&&again["Weights"]===first["Weights"],"identical finite-cover certificate reused"];
assert[!changed["FiniteCoverReused"]&&changed["Weights"]===2 first["Weights"],"changed complete rows invalidate the finite-cover cache"];
assert[$MessageList==={},"no unexpected messages"];Quit[0];
