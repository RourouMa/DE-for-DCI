root=DirectoryName[DirectoryName[$InputFileName]];
Get[FileNameJoin[{root,"Kernel","ConformalIBP.wl"}]];
Get[FileNameJoin[{root,"Examples","kinematics.wl"}]];
assert[t_,name_]:=If[TrueQ[t],Print["PASS ",name],Print["FAIL ",name];Quit[1]];
f=LadderFamily[2,kinematics,{x,y}];
a=G[2,0,0,0,0,2,0,0,2,1,1];b=G[1,1,0,0,1,1,0,0,2,1,1];c=G[3,-1,0,0,-1,3,0,0,2,1,1];
candidate=a+b-2 c;
fin=BuildFiniteBasis[f,{x candidate,y candidate}];
assert[AssociationQ[ConformalIBP`Private`finiteBasisContract[f,fin]],"certified constant cover accepted"];
assert[TrueQ[ConformalIBP`Private`finiteBasisContract[f,fin,{x candidate,y candidate}]["OrderingPreferencePreserved"]],"finite combination of surviving atoms preserves ordering"];
assert[MatchQ[ConformalIBP`Private`finiteBasisContract[f,fin,{a,b}],Failure["OrderingPreferenceViolation",_]],"a certified finite expression cannot reintroduce an eliminated integral"];
bad=Join[fin,<|"Basis"->Append[fin["Basis"],a]|>];
assert[MatchQ[ConformalIBP`Private`finiteBasisContract[f,bad],Failure["FiniteBasisCountMismatch",_]],"hidden extra basis element rejected"];
variable=Join[fin,<|"Basis"->(x fin["Basis"]),"Combinations"->(x fin["Combinations"]),"Weights"->fin["Weights"]/x|>];
assert[And@@(ConformalIBP`Private`zero /@ ({x candidate,y candidate}-variable["Weights"].variable["Basis"])),"variable cover remains exactly equivalent"];
assert[MatchQ[ConformalIBP`Private`finiteBasisContract[f,variable],Failure["VariableCoefficientDecisionRequired",_]],"unassessed variable choice requests a decision, not a permanent ban"];
decision=<|"Reason"->"Regression exercises a justified fallback; not a production recommendation.",
 "ConstantSearchSummary"->"Constant cover exists in this fixture.","RelationAudit"->"No relation change; identical exact span.",
 "AlternativesCompared"->"Constant and rescaled variable bases compared; variable used only to test the reporting contract."|>;
variable=Join[variable,<|"VariableCoefficientDecision"->decision|>];
assert[AssociationQ[ConformalIBP`Private`finiteBasisContract[f,variable]],"finite variable cover with recorded assessment is permitted"];
state=<|"Family"->f,"Epoch"->2,"Equations"->{a-b},"Options"-><|"OutputDirectory"->None|>|>;
der=<|"Targets"->{a,b,c}|>;red=<|"SelfReducedTargets"->{a},"UnseenTargets"->{},"VerificationMode"->"Numerical","NumericalVerificationPoints"->1|>;
report=ConformalIBP`Private`finiteRoundReport[state,3,fin["Basis"],der,{candidate},{x candidate},red,variable,1,{1}];
assert[report["OutputCount"]===1 && report["SingleFinite"]===0 && report["ConstantCombinations"]===0 && report["VariableCombinations"]===1,"all combination types counted separately without hidden basis"];
assert[report["RawSupport"]===3 && report["RawNotIndividuallyFinite"]===3 && !report["RawSupportIsMasterCount"],"divergent raw atoms are not reported as finite-cover or master counts"];
assert[MissingQ[report["ActualRationalRank"]] && !report["ActualRankVerified"],"unknown actual rank is never replaced by cover count"];
assert[!report["FullClosureVerified"] && !report["ClosedOnSameInput"] && report["UnclosedDERows"]==={1},"unclosed derivative rows and closure level remain explicit"];
assert[report["VariableCoefficientDecision"]===decision && report["ReplayNumber"]===2,"decision and replay identity preserved"];
f1=LadderFamily[1,kinematics,{x,y}];g=G[1,1,1,1,1];
scaled=<|"Basis"->{2 g},"SingleFinite"->{},"Combinations"->{2 g},"ExactCoverage"->True|>;
assert[MatchQ[ConformalIBP`Private`finiteBasisContract[f1,scaled,{g}],Failure["PreferredFiniteSinglesOmitted",_]],"even an equivalent finite cover cannot replace a preferred finite single by a new definition"];
d1=DifferentiateIntegrals[f1,{g}];d2=DifferentiateIntegrals[f1,{x g}];
assert[ConformalIBP`Private`zero[d2["Rows"][x][[1]]-g-x d1["Rows"][x][[1]]],"variable coefficient derivative includes product rule"];
assert[$MessageList==={},"no unexpected messages"];Quit[0];
