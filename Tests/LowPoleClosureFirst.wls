root=DirectoryName[DirectoryName[$InputFileName]];Get[FileNameJoin[{root,"Kernel","ConformalIBP.wl"}]];Get[FileNameJoin[{root,"Examples","kinematics.wl"}]];
assert[q_,name_]:=If[TrueQ[q],Print["PASS ",name],Print["FAIL ",name];Quit[1]];
f=LadderFamily[1,kinematics,{x,y}];top=G[1,1,1,1,1];old=RunDE[f,top,"MasterCountStrategy"->"UserEstimate","MasterCountUserUpperBound"->4,"Solver"->"Exact","ProgressFunction"->None];
assert[TrueQ[InitializeFiniteFlow[Environment["FINITEFLOW_ROOT"],FileNameJoin[{Environment["FINITEFLOW_ROOT"],"mathlink"}]]],"FiniteFlow initialized"];
{a,b}=Take[CanonicalIntegral[f,#]& /@ old["Basis"],2];
physical=<|"Basis"->{a+b},"PhysicalInput"->{a+b},"RawDerivative"->{},"PhysicalDE"->{},"FiniteCoverPolicy"->"LowPoleClosureFirst"|>;
reference=<|"FullReferenceQueries"->{a,b},"FullPoolNumericalRules"->{a->a,b->b},"Point"->{11,17},"Prime"->FiniteFlow`FFPrimeNo[0],"FullPoolHash"->0|>;
dir=CreateDirectory[FileNameJoin[{$TemporaryDirectory,"simple-cover-selection-"<>CreateUUID[]}]];
choice=ConformalIBP`Private`selectLowPolePhysicalBasis[f,physical,reference,dir,1];
assert[AssociationQ[choice]&&choice["Report"]["SampledActualRank"]===1&&Length[choice["Basis"]]===2&&AllTrue[choice["Basis"],MatchQ[#,_G]&],"two simple finite atoms may cover a rank-one combination before closure"];
physical["FiniteCoverPolicy"]="PreserveActualSpan";small=ConformalIBP`Private`selectLowPolePhysicalBasis[f,physical,reference,dir,1];
assert[Length[small["Basis"]]===1,"actual-span policy remains available for compression"];
{a,b,c,d}=CanonicalIntegral[f,#]& /@ old["Basis"];
physical=<|"Basis"->{a+b,c+d},"PhysicalInput"->{a+b,c+d},"RawDerivative"->{},"PhysicalDE"->{},"FiniteCoverPolicy"->"LowPoleClosureFirst","MaxRelativeCoverExcess"->1/2|>;
reference=Join[reference,<|"FullReferenceQueries"->{a,b,c,d},"FullPoolNumericalRules"->Thread[{a,b,c,d}->{a,b,c,d}]|>];
limited=ConformalIBP`Private`selectLowPolePhysicalBasis[f,physical,reference,dir,1];
assert[AssociationQ[limited]&&limited["Report"]["SampledActualRank"]===2&&Length[limited["Basis"]]===3,"a two-dimensional target uses at most one extra simple direction"];
assert[limited["Report"]["DerivedExtraCoverDirectionsLimit"]===1&&limited["Report"]["RelativeCoverExcess"]===0.5,"rank two converts 50 percent allowance into one extra direction"];
physical=<|"Basis"->{a+b},"PhysicalInput"->{a+b},"RawDerivative"->{},"PhysicalDE"->{},"FiniteCoverPolicy"->"LowPoleClosureFirst","MaxRelativeCoverExcess"->1/2|>;
scaled=ConformalIBP`Private`selectLowPolePhysicalBasis[f,physical,reference,dir,1];
assert[scaled["Report"]["DerivedExtraCoverDirectionsLimit"]===0&&Length[scaled["Basis"]]===1,"the same 50 percent allowance scales with rank and rounds down"];
assert[choice["Report"]["MaxRelativeCoverExcess"]===1.5&&choice["Report"]["DerivedExtraCoverDirectionsLimit"]===1,"Automatic uses the calibrated relative 150 percent ceiling"];
out=CreateDirectory[FileNameJoin[{$TemporaryDirectory,"low-pole-closure-first-"<>CreateUUID[]}]];
new=RunPhysicalCoordinateDE[f,{top},old["Equations"],"OutputDirectory"->out,"MasterCountUserUpperBound"->4,"Workers"->1,"FiniteReferenceBasis"->old["Basis"],"FiniteCoverPolicy"->"LowPoleClosureFirst"];
assert[AssociationQ[new]&&TrueQ[new["HighestLoopCandidateClosed"]]&&new["FiniteCoverPolicy"]==="LowPoleClosureFirst","simple-cover campaign reaches closure from Top"];
assert[AllTrue[new["History"],FileExistsQ[FileNameJoin[{out,"round"<>ToString[#["Round"]],"CoordinateCertificate.wl"}]]&],"coverage and actual-rank certificates are saved separately"];
wide=ConformalIBP`Private`projectRowsInPhysicalBasis[f,{a+b},{a,b},new["Reference"],FileNameJoin[{out,"wide-cover"}],1];
narrow=ConformalIBP`Private`projectRowsInPhysicalBasis[f,{a+b},{a+b},new["Reference"],FileNameJoin[{out,"actual-rank"}],1];
assert[AssociationQ[wide]&&AssociationQ[narrow]&&Dimensions[wide["Weights"]]==={1,2}&&Dimensions[narrow["Weights"]]==={1,1},"larger simple coverage and smaller actual rank receive separate rational certificates"];
cached=RunPhysicalCoordinateDE[f,{top},{},"OutputDirectory"->FileNameJoin[{out,"cached-replay"}],"CanonicalPoolCache"->new["FullPoolCacheIndex"],"MasterCountUserUpperBound"->4,"Workers"->1,"FiniteReferenceBasis"->old["Basis"],"FiniteCoverPolicy"->"LowPoleClosureFirst"];
assert[AssociationQ[cached]&&cached["HighestLoopCandidateClosed"]&&cached["Basis"]===new["Basis"]&&cached["FullPoolHash"]===new["FullPoolHash"],"hash-bound canonical physical-pool reuse reproduces the from-Top campaign"];
bad=RunPhysicalCoordinateDE[f,{top},{top},"OutputDirectory"->FileNameJoin[{out,"bad-cache-input"}],"CanonicalPoolCache"->new["FullPoolCacheIndex"]];
assert[FailureQ[bad],"a cache cannot silently replace a different nonempty equation input"];
custom=Append[f,"FiniteValidator"->Function[{family,expr},allow]];allow=True;yes=ConformalIBP`Private`cachedFiniteCandidateQ[custom,top];allow=False;no=ConformalIBP`Private`cachedFiniteCandidateQ[custom,top];
assert[yes&&!no,"custom finiteness validators are not cached"];
Put[<|"Run"->out,"BasisCount"->Length[new["Basis"]],"History"->new["History"]|>,FileNameJoin[{out,"Regression.wl"}]];Print["Regression run: ",out];assert[$MessageList==={},"no unexpected messages"];Quit[0];
