root=DirectoryName[DirectoryName[$InputFileName]];Get[FileNameJoin[{root,"Kernel","ConformalIBP.wl"}]];
assert[x_,label_]:=If[TrueQ[x],Print["PASS ",label],Print["FAIL ",label];Quit[1]];
kin={SP[X1,X1]->2 x,SP[X3,X3]->2 x,SP[X2,X2]->2 y,SP[X4,X4]->2 y,SP[X1,X3]->1+x^2,SP[X2,X4]->1+y^2,SP[X1,X2]->0,SP[X1,X4]->0,SP[X2,X3]->0,SP[X3,X4]->0};
f=LadderFamily[2,kin,{x,y}];g=CanonicalIntegral[f,G@@Join[f["TopSector"],{1,1}]];
b1=BoundaryIntegral[1,{1,1,1,1,1}];b2=BoundaryIntegral[1,{2,0,2,0,1}];b3=BoundaryIntegral[1,{3,0,1,0,1}];
eq={g-b1,b1-2 b2};events={};
a=ReduceIntegrals[f,{g},eq,"Solver"->"Exact"];
assert[!a["ReductionReused"] && a["NumericalEquationResidualsZero"] && a["Idempotent"],"initial solve fully verified"];
b=ReduceIntegrals[f,{x g+b1,b2},eq,"Solver"->"Exact","ProgressFunction"->(AppendTo[events,#]&)];
assert[b["ReductionReused"] && b["ReducedTargets"]==={2 (1+x) b2,b2},"new queries reuse same full system and refresh images"];
assert[MemberQ[Lookup[events,"Action"],"Reusing verified full reduction"] && !MemberQ[Lookup[events,"Action"],"Starting coefficient solve"],"cache hit skips coefficient solver"];
c=ReduceIntegrals[f,{x g+b1,b2},eq,"Solver"->"Exact","ReuseVerifiedReduction"->False];
keys={"Rules","ReducedTargets","RawMasters","BoundarySources","SelfReducedTargets","UnseenTargets","SameLoopRules","BoundaryRules","ColumnOrder"};
assert[KeyTake[b,keys]===KeyTake[c,keys],"cached query metadata matches independent fresh solve"];
d=ReduceIntegrals[f,{g},Append[eq,b2],"Solver"->"Exact"];
assert[!d["ReductionReused"] && d["ReducedTargets"]==={0},"new relation invalidates reduction"];
e=ReduceIntegrals[f,{g,b3},Append[eq,b2],"Solver"->"Exact"];
assert[!e["ReductionReused"] && e["ReducedTargets"]==={0,b3},"new column invalidates reduction"];
bad=ReduceIntegrals[f,{g},eq,"Solver"->Function[{rows,columns,queries},{g->b1}]];
assert[FailureQ[bad] && bad[[1]]==="UnverifiedReduction","custom solver still undergoes full source residual verification"];
fresh=ReduceIntegrals[f,{g},eq,"Solver"->"Exact"];
assert[!fresh["ReductionReused"] && fresh["ReducedTargets"]==={2 b2},"failed solve cannot poison cache"];
changedOption=ReduceIntegrals[f,{g},eq,"Solver"->"Exact","MaxExactColumns"->1];
assert[FailureQ[changedOption] && changedOption[[1]]==="ExactSizeLimit","changed solver constraints cannot bypass validation through cache"];
If[MemberQ[Join[$CommandLine,$ScriptCommandLine],"--finiteflow"],
 assert[InitializeFiniteFlow[Environment["FINITEFLOW_ROOT"],FileNameJoin[{Environment["FINITEFLOW_ROOT"],"mathlink"}]],"load FiniteFlow"];
 ff1=ReduceIntegrals[f,{g},eq,"Solver"->"FiniteFlow"];
 ff2=ReduceIntegrals[f,{x g+b1,b2},eq,"Solver"->"FiniteFlow"];
 ff3=ReduceIntegrals[f,{x g+b1,b2},eq,"Solver"->"FiniteFlow","ReuseVerifiedReduction"->False];
 assert[!ff1["ReductionReused"] && ff2["ReductionReused"],"FiniteFlow result reused only after initial verification"];
 assert[KeyTake[ff2,keys]===KeyTake[ff3,keys] && KeyTake[ff2,keys]===KeyTake[c,keys],"cached FiniteFlow agrees with fresh FiniteFlow and exact elimination"]];
assert[$MessageList==={},"no unexpected Wolfram messages"];Quit[0];
