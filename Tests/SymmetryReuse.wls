root=DirectoryName[DirectoryName[$InputFileName]];Get[FileNameJoin[{root,"Kernel","ConformalIBP.wl"}]];
assert[x_,label_]:=If[TrueQ[x],Print["PASS ",label],Print["FAIL ",label];Quit[1]];
kin={SP[X1,X1]->2 x,SP[X3,X3]->2 x,SP[X2,X2]->2 y,SP[X4,X4]->2 y,SP[X1,X3]->1+x^2,SP[X2,X4]->1+y^2,SP[X1,X2]->0,SP[X1,X4]->0,SP[X2,X3]->0,SP[X3,X4]->0};
f=LadderFamily[1,kin,{x,y}];g=G[1,1,1,1,1];
first=GenerateSystem[f,{g}];cache=ConformalIBP`Private`exportSymmetryCache[f];
assert[AssociationQ[first] && first["NewSymmetryInputs"]=!={},"first generation records symmetry inputs"];
ConformalIBP`Private`symmetryKnown[f["Hash"]]=<||>;
assert[TrueQ[ConformalIBP`Private`importSymmetryCache[f,cache]],"portable cache imported with fingerprints"];
misses=0;values=Block[{ConformalIBP`Private`canonMemo},ConformalIBP`Private`canonMemo[args___]:=(misses++;$Failed);CanonicalIntegral[f,#]& /@ Keys[cache["Mappings"]]];
assert[misses===0 && values===Values[cache["Mappings"]],"restored mappings require zero new orbit searches"];
second=GenerateSystem[f,{g},"CompletedApplications"->first["Applications"],"CompletedSymmetryInputs"->first["NewSymmetryInputs"]];
assert[second["Applications"]==={} && second["NewSymmetryInputs"]==={} && second["Equations"]==={},"repeat generation emits neither IBP applications nor symmetry relations"];
newTarget=G[2,0,1,1,1];third=GenerateSystem[f,{g,newTarget},"CompletedApplications"->first["Applications"],"CompletedSymmetryInputs"->first["NewSymmetryInputs"]];
assert[MemberQ[third["NewSymmetryInputs"],newTarget] && Intersection[third["NewSymmetryInputs"],first["NewSymmetryInputs"]]==={},"new integrals extend symmetry ledger without repeats"];
full=GenerateSystem[f,{g,newTarget}];
assert[Union[first["Equations"],third["Equations"]]===Union[first["Equations"],full["Equations"]],"incremental and fresh equation unions exactly match"];
bad=Append[cache,"FamilyHash"->0];assert[FailureQ[ConformalIBP`Private`importSymmetryCache[f,bad]],"wrong family rejected"];
bad=Append[cache,"ImplementationHash"->0];assert[FailureQ[ConformalIBP`Private`importSymmetryCache[f,bad]],"wrong implementation rejected"];
bad=Append[cache,"Hash"->0];assert[FailureQ[ConformalIBP`Private`importSymmetryCache[f,bad]],"changed content rejected"];
assert[$MessageList==={},"no unexpected Wolfram messages"];Quit[0];
