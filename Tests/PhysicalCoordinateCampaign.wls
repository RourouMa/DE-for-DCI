root=DirectoryName[DirectoryName[$InputFileName]];Get[FileNameJoin[{root,"Kernel","ConformalIBP.wl"}]];Get[FileNameJoin[{root,"Examples","kinematics.wl"}]];
assert[t_,name_]:=If[TrueQ[t],Print["PASS ",name],Print["FAIL ",name];Quit[1]];
f=LadderFamily[1,kinematics,{x,y}];top=G[1,1,1,1,1];
old=RunDE[f,top,"MasterCountStrategy"->"UserEstimate","MasterCountUserUpperBound"->4,"Solver"->"Exact","ProgressFunction"->None];
assert[TrueQ[old["Closed"]]&&Length[old["Basis"]]===4,"native one-loop physical fixture closes"];
assert[TrueQ[InitializeFiniteFlow[Environment["FINITEFLOW_ROOT"],FileNameJoin[{Environment["FINITEFLOW_ROOT"],"mathlink"}]]],"FiniteFlow initialized"];
out=CreateDirectory[FileNameJoin[{$TemporaryDirectory,"physical-coordinate-regression-"<>CreateUUID[]}]];
frame=(#/.g_G:>ConformalIBP`Private`relabel[f,g,Thread[f["External"]->f["External"][[{3,2,1,4}]]]])& /@ old["Basis"];
new=RunPhysicalCoordinateDE[f,{top},old["Equations"],"OutputDirectory"->out,"MasterCountUserUpperBound"->4,"Workers"->1,"FiniteReferenceBasis"->frame];
assert[AssociationQ[new]&&TrueQ[new["HighestLoopCandidateClosed"]],"coordinate route reaches a closure candidate from original Top"];
assert[!new["HighestLoopIndependentlyVerified"],"candidate is not prematurely labelled verified closure"];
assert[Length[new["Basis"]]<=4&&AllTrue[new["Basis"],TrueQ[FiniteIntegralQ[f,#]]&],"native finite independent cover respects the reference upper bound"];
assert[new["OriginalInputs"]==={top}&&And@@(FileExistsQ[FileNameJoin[{out,"round"<>ToString[#],"CoordinateCertificate.wl"}]]& /@ Range[Length[new["History"]]]),"from-Top certificates retained for every accepted round"];
full=ReconstructFiniteCoordinateSystem[<|1->f|>,new["Basis"],{top},old["Equations"],"OutputDirectory"->FileNameJoin[{out,"full-system"}],"Workers"->1];
assert[AssociationQ[full]&&TrueQ[full["Report"]["FullDEClosed"]]&&TrueQ[full["Report"]["NoSourcesDiscarded"]],"full-system reconstruction recomputes native derivatives and curvature from physical rows"];
cached=ReconstructFiniteCoordinateSystem[<|1->f|>,new["Basis"],{top},{},"CanonicalPhysicalPoolCaches"->{new["FullPoolCacheIndex"]},"OutputDirectory"->FileNameJoin[{out,"cached-full-system"}],"Workers"->1];
assert[AssociationQ[cached]&&TrueQ[cached["Report"]["FullDEClosed"]]&&Length[cached["Report"]["CanonicalPhysicalPoolCaches"]]===1,"full mixed reconstruction accepts a hash-bound complete canonical physical pool"];
assert[cached["Report"]["ReusedPhysicalColumnOrderCount"]>0,"full reconstruction reuses the cached physical column order"];
assert[AllTrue[Flatten[Values[cached["Matrices"]]-Values[full["Matrices"]]],ConformalIBP`Private`zero],"cached full physical rows reproduce exact native DE matrices"];
assert[FileExistsQ[FileNameJoin[{out,"cached-full-system","FullReference.mx"}]],"full-pool numerical reference is saved for later finite-cover refinement"];
extraIndex=Get[new["FullPoolCacheIndex"]];extraFile=FileNameJoin[{out,"extra-query-pool.mx"}];
Block[{ConformalIBP`Private`poolRows,ConformalIBP`Private`poolColumns,ConformalIBP`Private`poolMetadata},Get[extraIndex["File"]];ConformalIBP`Private`poolColumns=Append[ConformalIBP`Private`poolColumns,G[5,0,0,-1,1]];DumpSave[extraFile,{ConformalIBP`Private`poolRows,ConformalIBP`Private`poolColumns,ConformalIBP`Private`poolMetadata}]];
extraIndexFile=FileNameJoin[{out,"extra-query-index.wl"}];Put[Join[extraIndex,<|"File"->extraFile,"FileSHA256"->FileHash[extraFile,"SHA256"]|>],extraIndexFile];
extra=ReconstructFiniteCoordinateSystem[<|1->f|>,new["Basis"],{top},{},"CanonicalPhysicalPoolCaches"->{extraIndexFile},"OutputDirectory"->FileNameJoin[{out,"extra-query-full"}],"Workers"->1];
assert[AssociationQ[extra]&&TrueQ[extra["Report"]["FullDEClosed"]]&&AllTrue[Flatten[Values[extra["Matrices"]]-Values[full["Matrices"]]],ConformalIBP`Private`zero],"unused valid query columns in a cached pool do not alter full reconstruction"];
index=Get[new["FullPoolCacheIndex"]];badIndex=FileNameJoin[{out,"bad-index.wl"}];Put[Join[index,<|"FileSHA256"->index["FileSHA256"]+1|>],badIndex];
bad=ReconstructFiniteCoordinateSystem[<|1->f|>,new["Basis"],{top},{},"CanonicalPhysicalPoolCaches"->{badIndex},"OutputDirectory"->FileNameJoin[{out,"bad-cached-full"}]];
assert[MatchQ[bad,Failure["FullCanonicalPoolHash",_]],"mismatched canonical physical cache file hash is rejected"];
other=CreateFamily[Join[KeyDrop[f,{"Hash"}],<|"Name"->"DifferentFamilyMetadata"|>]];
bad=ReconstructFiniteCoordinateSystem[<|1->other|>,new["Basis"],{top},{},"CanonicalPhysicalPoolCaches"->{new["FullPoolCacheIndex"]},"OutputDirectory"->FileNameJoin[{out,"wrong-family-full"}]];
assert[MatchQ[bad,Failure["FullCanonicalPoolFamily",_]],"canonical physical cache cannot be reused under a different family hash"];
Put[Join[index,<|"FullPoolHash"->index["FullPoolHash"]+1|>],badIndex];
bad=ReconstructFiniteCoordinateSystem[<|1->f|>,new["Basis"],{top},{},"CanonicalPhysicalPoolCaches"->{badIndex},"OutputDirectory"->FileNameJoin[{out,"wrong-row-hash-full"}]];
assert[MatchQ[bad,Failure["FullCanonicalPoolRows",_]],"declared canonical physical row hash is checked independently of the file hash"];
incomplete=ReconstructFiniteCoordinateSystem[<|1->f|>,Drop[new["Basis"],-1],{top},old["Equations"],"OutputDirectory"->FileNameJoin[{out,"incomplete-system"}],"Workers"->1];
assert[FailureQ[incomplete],"an incomplete finite basis is rejected by the full-pool span witness"];
Put[<|"Run"->out,"CandidateCount"->Length[new["Basis"]],"Messages"->$MessageList|>,FileNameJoin[{out,"Regression.wl"}]];
assert[$MessageList==={},"no unexpected messages"];Quit[0];
