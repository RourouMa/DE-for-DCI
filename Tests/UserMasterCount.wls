root=DirectoryName[DirectoryName[$InputFileName]];
Get[FileNameJoin[{root,"Kernel","ConformalIBP.wl"}]];Get[FileNameJoin[{root,"Examples","kinematics.wl"}]];
assert[t_,name_]:=If[TrueQ[t],Print["PASS ",name],Print["FAIL ",name];Quit[1]];
f=LadderFamily[4,kinematics,{x,y}];top=G@@Join[f["TopSector"],ConstantArray[1,4]];
o=Join[Association[Options[RunDE]],Association[Get[FileNameJoin[{root,"Examples","four-loop-count-policy.wl"}]]],<|"ProgressFunction"->None|>];
state=ConformalIBP`Private`makeState[f,{top},"DE",o];
pre=Block[{MasterIntegralCount=(Throw["Unexpected geometry count"]&),TopDerivativeBound=(Throw["Unexpected annihilator count"]&)},ConformalIBP`Private`masterCountPreflight[state]];
assert[pre["CanStartDE"]&&pre["StoppingThreshold"]===100&&pre["ThresholdOrigin"]==="UserEstimate","four-loop policy uses 100 without geometric work"];
assert[!pre["IsMasterIntegralUpperBound"]&&MissingQ[pre["CertifiedUpperBound"]]&&pre["LoopUpperBounds"][4]===100&&MissingQ[pre["LoopUpperBounds"][3]],"user estimate and lower-loop unknowns are not mathematical certificates"];
state["MasterCountPreflight"]=pre;state["TopBoundBasisScopePreserved"]=False;
input=G /@ Range[99];source=BoundaryIntegral[3,ConstantArray[1,18]];
a=ConformalIBP`Private`masterCountRankAudit[state,input,{G[100]+source}];
assert[a["InputRank"]===99&&a["InputAndDerivativeRank"]===100&&!a["Exceeded"],"100 independent same-loop directions do not exceed the cap; sources excluded only from rank"];
b=ConformalIBP`Private`masterCountRankAudit[state,input,{G[100]+source,G[101]}];
assert[b["Exceeded"]&&b["InputAndDerivativeRank"]===101&&b["ApplicableToCurrentBasis"],"101 directions trigger repair even if an ordering basis enlarged the top span"];
c=ConformalIBP`Private`masterCountRankAudit[state,{Total[G /@ Range[101]]},{x Total[G /@ Range[101]]+source}];
assert[c["InputAndDerivativeRank"]===1&&!c["Exceeded"],"101 atoms in a single direction are not 101 masters"];
bad=state;bad["Options"]=Join[o,<|"MasterCountUserUpperBound"->0|>];
assert[FailureQ[ConformalIBP`Private`masterCountPreflight[bad]],"invalid estimate rejected"];
f1=LadderFamily[1,kinematics,{x,y}];g=G[1,1,1,1,1];events={};
run=RunDE[f1,g,"MasterCountStrategy"->"UserEstimate","MasterCountUserUpperBound"->1,"MasterCountPreflight"->"Required",
 "Solver"->"Exact","MaxRounds"->5,"MaxSystemExpansions"->8,"ProgressFunction"->(AppendTo[events,#]&)];
assert[AssociationQ[run]&&!run["Closed"]&&FailureQ[run["Status"]]&&run["Status"][[1]]==="MasterCountBoundExceeded","insufficient estimate stops after repair, without declaring closure"];
assert[AnyTrue[events,Lookup[#,"Event",None]==="PoolExpanded"&]&&run["CompletedApplications"]=!={},"exceedance actually attempts expansion and replay"];
assert[AllTrue[Select[events,Lookup[#,"Event",None]==="RoundStarted"&],#["Round"]===1&]&&run["History"]==={},"exceedance never differentiates an accepted larger basis"];
assert[run["OriginalInputs"]==={g}&&run["UnverifiedRows"]=!={},"original input and unresolved rows retained"];
normal=RunDE[f1,g,"MasterCountStrategy"->"UserEstimate","MasterCountUserUpperBound"->4,"Solver"->"Exact","ProgressFunction"->None];
assert[normal["Closed"]&&normal["FlatnessVerified"]&&Length[normal["Basis"]]===4,"at the threshold ordinary closure and flatness checks still run"];
assert[$MessageList==={},"no unexpected Wolfram messages"];Quit[0];
